# 检查当前是否所有变更均已暂存（用于格式化后重新暂存，防止反复提交）
if [ -z "$(git diff --name-only)" ] && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    ALL_STAGED=true
else
    ALL_STAGED=false
fi

# 更新版本号
node .husky/update-version.js

# 格式化代码
npm run format

# 只有 Rust 文件有变更时才运行 cargo fmt
if git diff --cached --name-only --diff-filter=ACM | rg -n "\\.rs$" >/dev/null; then
    cd src-tauri
    cargo fmt
    cd ..
fi

# 暂存修改的版本文件
git add package.json
git add src-tauri/tauri.conf.json
git add src-tauri/Cargo.lock
git add src-tauri/Cargo.toml

# 如果格式化前所有文件均已暂存，则格式化结束后重新暂存全部文件，防止反复提交
if [ "$ALL_STAGED" = "true" ]; then
    git add .
fi

