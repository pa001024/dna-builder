# 永远在仓库根运行：git commit 可能在子目录触发，相对路径与工具调用都以根为准
cd "$(git rev-parse --show-toplevel)"

# 带退避重试的 git add：编辑器后台 git（status / fetch）在大仓库上会短暂占住 index.lock，
# 直接 add 遇到锁就整单失败；这里最多等 ~30s，实在拿不到才报错退出。
git_add_retry() {
    attempts=0
    while [ "$attempts" -lt 20 ]; do
        if git add "$@" 2>/dev/null; then
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 3
    done
    git add "$@"
}

# 检查当前是否所有变更均已暂存（用于格式化后重新暂存，防止反复提交）
if [ -z "$(git diff --name-only)" ] && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    ALL_STAGED=true
else
    ALL_STAGED=false
fi

# 更新版本号
node .husky/update-version.js

# 只格式化本次涉及的文件（已暂存 + 工作区修改 + 未跟踪新文件），避免全仓扫描；
# biome 认识的扩展名才传，删掉/不存在的文件跳过
FORMATTABLE_EXT='\.(ts|tsx|mts|cts|js|mjs|cjs|jsx|json|jsonc|css|html|vue)$'
# dob-ui 上游原样目录：biome.json 里已 ignore，显式传路径时 biome 会以“无文件可处理”报错退出，
# 这里提前剔除（与 biome.json 的 ignore 保持同口径），db/ 与 runtime/ 是自有代码仍要格式化
DOB_UI_UPSTREAM='^packages/dob-ui/(base|components|utilities|functions|theme)/|^packages/dob-ui/(imports|index)\.js$'
CHANGED_FILES="$({
    git diff --name-only --cached --diff-filter=ACMRTUXB
    git diff --name-only --diff-filter=ACMRTUXB
    git ls-files --others --exclude-standard
} | sort -u | grep -E "$FORMATTABLE_EXT" | grep -v -E "$DOB_UI_UPSTREAM" || true)"

EXISTING_FILES=""
if [ -n "$CHANGED_FILES" ]; then
    EXISTING_FILES="$(printf '%s\n' "$CHANGED_FILES" | while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] && printf '%s\n' "$f"
    done)"
fi

if [ -n "$EXISTING_FILES" ]; then
    # -s 7000：xargs 默认按 ARG_MAX 分块（上百 KB），Windows cmd 上限 8k 会直接报错跳过格式化
    printf '%s\n' "$EXISTING_FILES" | xargs -s 7000 pnpm exec biome check --write --linter-enabled=false --
fi

# 只有 Rust 文件有变更时才运行 cargo fmt
if git diff --cached --name-only --diff-filter=ACM | rg -n "\\.rs$" >/dev/null; then
    cd apps/web/src-tauri
    cargo fmt
    cd ../../..
fi

# 暂存修改的版本文件
git_add_retry -- package.json apps/web/package.json apps/web/src-tauri/tauri.conf.json apps/web/src-tauri/Cargo.lock apps/web/src-tauri/Cargo.toml

# 格式化前已全部暂存时，把钩子引入的改动（biome 格式化 / cargo fmt / 版本号与 i18n 排序）补回暂存区。
# 直接取格式化后的 worktree 差异走 pathspec-from-file：不拼长命令行（本仓库一次变更可达上千文件），
# 也兼容文件名空格。注意不能用 `printf | while` 分批 add——while 在管道子 shell 里跑，攒的列表传不回父 shell，
# 文件数不足一批时尾单直接丢失，一个都加不回去。
if [ "$ALL_STAGED" = "true" ]; then
    REMAINING="$(git diff --name-only)"
    if [ -n "$REMAINING" ]; then
        STAGE_TMP="$(mktemp)"
        printf '%s\n' "$REMAINING" > "$STAGE_TMP"
        git_add_retry --pathspec-from-file="$STAGE_TMP"
        rm -f "$STAGE_TMP"
    fi
fi

