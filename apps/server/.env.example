# API配置
API_TOKEN=your_api_token_here
API_BASE_URL=https://your-api-base-url.com/

# JJJ配置
DEV_CODE=your_dev_code_here
USER_TOKEN=your_user_token_here
USER_ID=your_user_id_here

# AI配置（/api/v1/chat/completions 代理：按登录账号计费，每人每天 0.5 元）
# 上游使用 DeepSeek OpenAI 兼容接口，模型固定 deepseek-flash，计费口径与 DeepSeek 官方峰谷价对齐
AI_API_KEY=your_ai_api_key_here
AI_MODEL=deepseek-flash
AI_BASE_URL=https://api.deepseek.com/
AI_EMBEDDING_API_KEY=sk-???
AI_EMBEDDING_MODEL=BAAI/bge-m3
# OpenAI 兼容 embeddings 的完整端点（必填，含 /embeddings）；向量库后端由下方 DashVector 三件套是否配齐决定
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
# 可选：语言白名单（逗号分隔，如 zh,en,ja）。只为白名单内的语言构建向量索引（预热/--index-all/请求触发都受限）；
# 支持的语言代码：zh / en / jp / kr / fr / tc（ja、ko 会归一到 jp、kr）。留空 = 全部支持的语言
AI_EMBEDDING_LANG=
# 可选：索引库文件路径（两种后端共用该配置；默认 server/data/rag-index.duckdb）
RAG_INDEX_DB=
# 可选：检索接口每账号每分钟限流次数（默认 60）；压测时临时调高
RAG_SEARCH_RATE_LIMIT=
# 可选：HTTP 监听端口（默认 8887）
PORT=
# DashVector 三件套配齐 = 启用远端向量库（本地只留元数据，检索直接走远端）；留空任一项 = 存本地索引库（DuckDB + HNSW）。
# 集群 endpoint（控制台给的地址，不带协议头）与集合名；集合维度需与 AI_EMBEDDING_DIM 一致
AI_EMBEDDING_SERVER_ENDPOINT=
AI_EMBEDDING_SERVER_API_KEY=
AI_EMBEDDING_SERVER_COLLECTION=
# 可选：指定输出维度（MRL 模型按它截断，例如 Qwen3-Embedding-8B 原生 4096 维，可设 1024 把索引体积压回 bge-m3 量级）
# 不填则用模型原生维度；要求显式指定维度的渠道必须填。改动后需重建索引（维度变化会自动转全量重建）
AI_EMBEDDING_DIM=1024
# 可选：单请求文本条数（默认 256，上限 1024）。批越大每请求固定开销摊得越薄，重建越快；上游限制 input 长度时下调
AI_EMBEDDING_BATCH_SIZE=

# AI 调用日志（记录每次请求的元数据与完整对话，按日期归档到 data/ai-logs）
# 关闭记录：AI_LOG_ENABLED=false
AI_LOG_ENABLED=true
# 日志根目录，默认 server/data/ai-logs
AI_LOG_DIR=
# 单条内容落盘上限（字符），超出部分截断并标记；设为 0 表示不限制
AI_LOG_MAX_CONTENT_CHARS=0
# 保留天数，超过则自动清理（启动时与每 6 小时各检查一次）；留空或 0 表示不自动清理
AI_LOG_RETENTION_DAYS=3

# OSS配置
OSS_ENDPOINT=oss-cn-region.aliyuncs.com
OSS_ACC_ENDPOINT=oss-accelerate.aliyuncs.com
OSS_BUCKET=your_bucket_name
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
CDN_URL=https://cdn.dna-builder.cn

# R2 冗余源（与 OSS 双写；缺失时服务端上传退化为单源）
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_ACCESS_KEY_SECRET=your_r2_access_key_secret
R2_URL=https://cdn.dobapp.cc

# 官方差分下载配置；未设置时使用项目内置的官方 CDN 源
# 数据包：默认 https://cdn.dna-builder.cn/data-pack/
OFFICIAL_DATA_PACK_BASE_URL=https://cdn.dna-builder.cn/data-pack/
# HDiffPatch 的 hdiffz 可执行文件路径
HDIFFZ_PATH=/usr/local/bin/hdiffz
# 可选：数据包与差分缓存目录
PACKAGE_DIFF_CACHE_DIR=/var/cache/dna-builder/package-diff

# 管理员配置
ADMIN_EMAIL=admin@example.com

# SMTP配置
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=DNA Builder <noreply@example.com>
