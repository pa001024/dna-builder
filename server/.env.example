# API配置
API_TOKEN=your_api_token_here
API_BASE_URL=https://your-api-base-url.com/

# JJJ配置
DEV_CODE=your_dev_code_here
USER_TOKEN=your_user_token_here
USER_ID=your_user_id_here

# AI配置
AI_API_KEY=your_ai_api_key_here
AI_MODEL=GLM-4.6V-Flash
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# OSS配置
OSS_ENDPOINT=oss-cn-region.aliyuncs.com
OSS_BUCKET=your_bucket_name
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
CDN_URL=https://your-cdn-url.com

# 官方差分下载配置；未设置时使用项目内置的官方 CDN 源
# 数据包：默认 https://cdn.dna-builder.cn/data-pack/ 与其 versions.json
OFFICIAL_DATA_PACK_BASE_URL=https://cdn.dna-builder.cn/data-pack/
# 可选：不填时由 OFFICIAL_DATA_PACK_BASE_URL 自动拼接 versions.json
OFFICIAL_DATA_PACK_VERSIONS_URL=https://cdn.dna-builder.cn/data-pack/versions.json
# 桌面更新：默认依次使用 Tauri 配置中的 CDN 与 GitHub endpoints
OFFICIAL_UPDATE_MANIFEST_URLS=https://cdn.dna-builder.cn/latest.json,https://github.com/pa001024/dna-builder/releases/latest/download/latest.json
# 可选：不填时使用 latest.json 中 MSI 文件所在目录
OFFICIAL_UPDATE_PACKAGE_BASE_URL=https://cdn.dna-builder.cn/
# HDiffPatch 的 hdiffz 可执行文件路径
HDIFFZ_PATH=/usr/local/bin/hdiffz
# 可选：数据包、更新包与差分缓存目录
PACKAGE_DIFF_CACHE_DIR=/var/cache/dna-builder/package-diff

# 管理员配置
ADMIN_EMAIL=admin@example.com

# SMTP配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=DNA Builder <noreply@example.com>
