{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": ["ESNext"],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "esModuleInterop": false,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["bun-types"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["./apps/web/src/*"],
            "@/data": ["./packages/data/index.ts"],
            "@/data/*": ["./packages/data/*"],
            "dna-builder-data": ["./packages/data/index.ts"],
            "dna-builder-data/*": ["./packages/data/*"]
        }
    },
    "include": ["tools/**/*.ts", "apps/web/src/**/*.ts", "packages/data/**/*.ts"],
    "exclude": ["node_modules", "**/node_modules", "**/dist/**", "apps/web/src-tauri/target"]
}
