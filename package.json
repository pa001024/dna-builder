{
    "name": "dna-builder",
    "private": true,
    "version": "1.4.12",
    "type": "module",
    "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
    "scripts": {
        "dev": "pnpm --filter dna-builder-web dev",
        "build": "pnpm --filter dna-builder-web build",
        "build:app": "pnpm --filter dna-builder-web build:app",
        "preview": "pnpm --filter dna-builder-web preview",
        "ssg": "pnpm --filter dna-builder-web ssg",
        "lint": "bun tools/incremental-lint.ts",
        "lint:full": "biome lint --fix && pnpm --filter dna-builder-web lint:tsc",
        "test": "pnpm --filter dna-builder-web test && pnpm --filter dna-builder-data test && vitest run",
        "test:web": "pnpm --filter dna-builder-web test",
        "test:data": "pnpm --filter dna-builder-data test",
        "test:tools": "vitest run",
        "test:e2e": "pnpm --filter dna-builder-web test:e2e",
        "test:e2e:headed": "pnpm --filter dna-builder-web test:e2e:headed",
        "tb": "pnpm --filter dna-builder-web tb",
        "mb": "pnpm --filter dna-builder-web mb",
        "dd": "pnpm --filter dna-builder-web dd",
        "dd2": "pnpm --filter dna-builder-web dd2",
        "dp": "bun tools/data-pack.ts build",
        "ip": "bun tools/imgs-pack.ts build",
        "apk": "bun tools/app-upload.ts",
        "voice:scan": "bun tools/voice/scan-missing.ts",
        "voice:ref-index": "bun tools/voice/ref-voice-index.ts",
        "voice:story-index": "bun tools/voice/ref-voice-story.ts",
        "voice:synth": "bun tools/voice/synthesize.ts",
        "voice:qa": "bun tools/voice/qa-sweep.ts",
        "voice:upload": "bun tools/voice/upload-aistory.ts",
        "build:dob-script": "cargo build --manifest-path crates/dob-script-runtime/Cargo.toml --release --features dob-script-cli --example dob-script && node tools/prepare-dob-script.mjs",
        "build:dob-calc-core": "cargo build --manifest-path crates/dob-calc-core/Cargo.toml --target wasm32-unknown-unknown --release && node tools/prepare-dob-calc-core.mjs",
        "build:all": "pnpm build:app",
        "build:api": "cd packages/dna-api && bun run build && cd ../.. && pnpm install",
        "debug:mcp": "npx -y @modelcontextprotocol/inspector npx -y tsx ./packages/data/mcp/index.ts",
        "prepare": "husky",
        "format": "biome check --write --linter-enabled=false",
        "fmttw": "bun tools/canonicalize-tailwind-classes.ts && biome check --write --linter-enabled=false",
        "ver": "node .husky/update-version.js",
        "pp": "bun tools/deploy.ts",
        "icon": "bun run tools/icon-tool.ts",
        "i18n": "bun tools/i18n.ts",
        "importdata": "bun run tools/import-i18n-data.ts",
        "prune-i18n": "bun tools/prune-migrated-i18n.ts",
        "iattr": "bun tools/import-attr-i18n.ts",
        "imgs-upload": "bun tools/imgs-upload.ts",
        "wi": "bun tools/webp-import.ts",
        "itf": "bun tools/import-title-frame.ts",
        "loc": "bun run tools/count-effective-loc.ts",
        "gen": "bun run tools/generate-api-calls.ts",
        "publish:dob-script": "pnpm run build:dob-script && cd packages/dob-script && npm publish --access public --registry https://registry.npmjs.org/",
        "bench:charbuild:real": "bun tools/benchmark-charbuild.ts"
    },
    "dependencies": {
        "dna-builder-data": "file:packages/data"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@msgpack/msgpack": "^3.1.3",
        "@tailwindcss/node": "^4.3.3",
        "@types/ali-oss": "^6.23.3",
        "@types/lodash-es": "^4.17.12",
        "@types/markdown-it": "^14.2.0",
        "@types/node-forge": "^1.3.14",
        "@types/three": "^0.182.0",
        "ali-oss": "^6.23.0",
        "bcryptjs": "^3.0.3",
        "bun-types": "^1.4.2",
        "daisyui": "^5.7.47",
        "dotenv": "^17.4.2",
        "fflate": "^0.8.3",
        "glob": "^13.0.6",
        "graphql": "^16.14.2",
        "husky": "^9.1.7",
        "i18next": "^25.10.10",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "vitest": "^4.1.11",
        "wasm-opt": "2.0.1"
    }
}
