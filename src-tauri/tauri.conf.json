{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "DNA Builder",
    "version": "1.1.2",
    "identifier": "com.pa.dna-builder",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build:app",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "DNA Builder",
                "fullscreen": false,
                "resizable": true,
                "decorations": false,
                "width": 1200,
                "height": 800,
                "transparent": true,
                "minWidth": 330,
                "minHeight": 430,
                "dragDropEnabled": false,
                "devtools": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": false,
        "targets": ["msi"],
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "externalBin": [],
        "windows": {
            "wix": {
                "language": "zh-CN"
            }
        },
        "resources": ["resources/HPatchz-LICENSE.txt"]
    }
}
