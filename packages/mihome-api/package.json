{
    "name": "@pa001024/mihome-api",
    "version": "1.0.0",
    "description": "Mi Home cloud protocol client (TypeScript implementation)",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "license": "MIT",
    "homepage": "https://github.com/pa001024/dna-builder",
    "repository": {
        "type": "git",
        "url": "https://github.com/pa001024/dna-builder.git",
        "directory": "packages/mihome-api"
    },
    "scripts": {
        "test": "vitest run",
        "lint": "tsc --noEmit",
        "build": "tsc --project tsconfig.build.json"
    },
    "devDependencies": {
        "typescript": "~5.6.2",
        "vitest": "^4.0.15"
    },
    "files": ["dist/**/*", "README.md", "NOTICE"]
}
