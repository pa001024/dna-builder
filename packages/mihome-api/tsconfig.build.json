{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "emitDeclarationOnly": false,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "types": []
    },
    "include": ["src/**/*.ts"],
    "exclude": ["**/*.test.ts", "dist", "node_modules"]
}
