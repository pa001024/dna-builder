{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": false,
        "outDir": "dist",
        "rootDir": "."
    },
    "include": ["*.ts", "d/*.ts", "leveled/*.ts", "mcp/*.ts", "rag/*.ts"],
    "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/*.config.ts", "tests", "scripts", "dist", "node_modules"]
}
