{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM"],
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "types": ["bun-types"],
        "baseUrl": ".",
        "paths": {
            "dna-builder-data": ["../data/index.ts"],
            "dna-builder-data/*": ["../data/*"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "fixtures/**/*.ts"]
}
